# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Liara PostgreSQL
PG_URI="postgresql://USER:PASSWORD@pgo:5432/postgres"
# Use DATABASE_URL instead of PG_URI only if your provider supplies that name.
DATABASE_URL=""
DATABASE_SSL="false"
PG_POOL_MAX="10"
PORT="3000"
NODE_ENV="production"

# Liara Object Storage (S3-compatible)
LIARA_ENDPOINT="https://storage.c2.liara.site"
LIARA_BUCKET_NAME="inana"
LIARA_ACCESS_KEY=""
LIARA_SECRET_KEY=""

# Gold Price API Configuration (Navasan Tech API)
GOLD_API_KEY=""
GOLD_API_URL="https://api.navasan.tech/latest/?api_key="

# SMS OTP Provider Configuration (s.api.ir)
SMS_OTP_API_KEY=""
SMS_OTP_URL="https://s.api.ir/api/sw1/SmsOTP"

# Authentication & Security
SESSION_SECRET=""
ADMIN_DEFAULT_PASSWORD=""
ADMIN_EMAIL="admin@inanagold.ir"
ADMIN_PHONE="09120000000"

# Firebase / Google sign-in server verification
FIREBASE_WEB_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
GOOGLE_CLIENT_ID=""

